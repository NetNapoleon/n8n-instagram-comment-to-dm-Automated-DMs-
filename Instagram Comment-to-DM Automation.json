    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst body = $('Instagram Events (POST)').first().json.body || {};\nconst keywords = (cfg.keywords || []).map(k => String(k).toLowerCase()).filter(Boolean);\nconst out = [];\nfor (const entry of (body.entry || [])) {\n  const rawTime = Number(entry.time || 0);\n  const timeMs = rawTime > 1e12 ? rawTime : rawTime * 1000;\n  for (const ch of (entry.changes || [])) {\n    if (ch.field !== 'comments') continue;\n    const v = ch.value || {};\n    const text = String(v.text || '');\n    const lower = text.toLowerCase();\n    const matched = keywords.find(k => lower.includes(k)) || '';\n    out.push({ json: {\n      event_type: 'comment',\n      comment_id: String(v.id || ''),\n      comment_text: text,\n      commenter_id: String((v.from || {}).id || ''),\n      commenter_username: String((v.from || {}).username || ''),\n      media_id: String((v.media || {}).id || ''),\n      parent_id: String(v.parent_id || ''),\n      matched_keyword: matched,\n      account_id: String(entry.id || ''),\n      event_time_ms: timeMs || Date.now(),\n    } });\n  }\n  for (const m of (entry.messaging || [])) {\n    const msg = m.message || {};\n    out.push({ json: {\n      event_type: 'message',\n      sender_id: String((m.sender || {}).id || ''),\n      recipient_id: String((m.recipient || {}).id || ''),\n      message_text: String(msg.text || ''),\n      is_echo: !!msg.is_echo,\n      account_id: String(entry.id || ''),\n      event_time_ms: timeMs || Date.now(),\n    } });\n  }\n}\nreturn out;"
      },
